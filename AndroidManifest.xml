<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.cube.launcher">
    <!-- versionCode/versionName come from the VERSION file (see build.sh). -->

    <!-- Granted over ADB (pm grant): lets HomeService see the Home key in the system log. -->
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- Granted over ADB (pm grant): when the user opens Cube Home, it can switch its
         Home button service back on if it was turned off (see SelfRepair). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- Daily wallpaper (Bing photo of the day), cached on the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update from GitHub releases (the TV asks before installing). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Cube Home"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/CubeTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HomeService"
            android:exported="true"
            android:label="Cube Home button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_service" />
        </service>
        <!-- Self-update: install status, and "Cube Home was updated". -->
        <receiver android:name=".Updater$Receiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
